programa {
  funcao inicio() {
    inteiro num, palpite

    num=10

    escreva("Digite seu palpite:")
    leia(palpite)
    
   enquanto(palpite!=10){

    escreva("Vc errou")
    
   escreva("\n Digite seu palpite:")
   leia(palpite)
   

   }
    se(palpite==10)
    escreva("Parabéns vôce ganhou!!")

    




  }
}

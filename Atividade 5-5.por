programa {
  funcao inicio() {
    real num1,num2,num3,soma

    escreva("Digite o primeiro número:")
    leia(num1)
    escreva("Digite o segundo número:")
    leia(num2)
    escreva("Digite terceiro número:")
    leia(num3)
    
    soma=num1+num2+num3

    escreva("A média desses números é:", soma/3)
    
  }
}
